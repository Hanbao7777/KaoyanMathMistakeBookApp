{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist/launcher-build",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["packages/kaoyan-mcp-stdio/src/**/*.cjs", "src/shared/mcp/v1/**/*.ts", "src/shared/agent/**/*.ts"]
}
