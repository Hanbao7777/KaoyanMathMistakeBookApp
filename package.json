{
  "name": "kaoyan-math-mistake-book",
  "version": "0.1.0",
  "description": "考研高数错题本桌面端 App",
  "author": "Aminos",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --configLoader native",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on tcp:5173 file:dist/main/main/main.js file:dist/main/preload/preload.js && electron .",
    "build": "tsc -p tsconfig.main.json && vite build --configLoader native",
    "test": "npm run build && npm run build:launcher && npm run build:launcher:test-fixture && node --test --test-concurrency=4 tests/**/*.test.cjs",
    "test:main": "npm run build:main && node --test --test-concurrency=4 tests/main/**/*.test.cjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:launcher:js": "tsc -p tsconfig.launcher.json",
    "build:launcher": "npm run build:launcher:js && pkg --target node22-win-x64 --output dist/mcp-stdio/kaoyan-mcp.exe dist/launcher-build/packages/kaoyan-mcp-stdio/src/launcher.cjs && node scripts/build-mcp-launcher-manifest.cjs",
    "build:launcher:test-fixture": "pkg --target node22-win-x64 --output dist/mcp-stdio/kaoyan-fake-app.exe tests/mcp/launcher/fakeApp.cjs",
    "test:launcher:real": "npm run build:main && npm run build:launcher && npm run build:launcher:test-fixture && node --test tests/mcp/launcher/realProcess.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "pack:win": "npm run build && npm run build:launcher && electron-builder --win portable --x64 && node scripts/verify-phase-c-package.cjs"
  },
  "build": {
    "appId": "com.local.kaoyan.math.mistakebook",
    "productName": "考研高数错题本",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/mcp-stdio/**/*",
      "!dist/launcher-build/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      },
      {
        "from": "resources/knowledge_map_seed.zip",
        "to": "knowledge_map_seed.zip"
      },
      {
        "from": "dist/mcp-stdio/kaoyan-mcp.exe",
        "to": "mcp-stdio/kaoyan-mcp.exe"
      },
      {
        "from": "dist/mcp-stdio/launcher-manifest.json",
        "to": "mcp-stdio/launcher-manifest.json"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.10.2",
    "adm-zip": "^0.5.16",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@yao-pkg/pkg": "6.21.0",
    "concurrently": "^9.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
